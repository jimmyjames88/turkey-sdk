{
  "name": "@jimmyjames88/turkey-sdk-next",
  "version": "0.2.0",
  "description": "Next.js middleware wrapper for TurKey SDK (Edge Runtime compatible)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmyjames88/turkey-sdk.git",
    "directory": "packages/turkey-sdk-next"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "echo \"No tests yet\"",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build",
    "publish:github": "npm publish"
  },
  "keywords": [
    "authentication",
    "jwt",
    "nextjs",
    "middleware",
    "edge-runtime",
    "turkey",
    "auth"
  ],
  "author": "TurKey Auth",
  "license": "MIT",
  "devDependencies": {
    "@jimmyjames88/eslint-config": "^1.0.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.10.0",
    "eslint": "^8.54.0",
    "prettier": "^3.0.3",
    "rollup": "^4.6.1",
    "rollup-plugin-dts": "^6.2.3",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@jimmyjames88/turkey-sdk": "*",
    "jose": "^6.1.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  }
}
